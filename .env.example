# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=news-articles

# OpenAI Configuration
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4o-mini

# Slack Configuration (one webhook URL per topic)
SLACK_WEBHOOK_TECH=https://hooks.slack.com/triggers/...
SLACK_WEBHOOK_AI=https://hooks.slack.com/triggers/...
SLACK_WEBHOOK_EDUCATION=https://hooks.slack.com/triggers/...
SLACK_WEBHOOK_CYBER_SECURITY=https://hooks.slack.com/triggers/...

# Slack operational alerts (errors, timeouts, missed runs) — used by Terraform, not the app directly
SLACK_ALERT_WEBHOOK=https://hooks.slack.com/triggers/...

# Feature Flags
# ENABLE_SLACK options: true (send to Slack) | log (print digest to terminal) | false (disabled)
ENABLE_SLACK=true
ENABLE_SUMMARIZATION=true
ENABLE_PERSISTENCE=true
ENABLE_LLM_CLASSIFICATION=true
ENABLE_EMBEDDINGS=false  # set to true to embed articles into Qdrant for RAG queries

# Qdrant (vector store for RAG — only used when ENABLE_EMBEDDINGS=true)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=  # required for Qdrant Cloud, leave blank for local

# Feed config path (set this in Lambda — defaults to config/feeds.yaml relative to project root locally)
# FEED_CONFIG_PATH=/opt/config/feeds.yaml

# Logging
LOG_LEVEL=INFO
# LOG_FILE=logs/run.log  — written automatically when running locally; set to "none" to disable

# Limits
MAX_ARTICLES_PER_FEED=50
MAX_SUMMARY_LENGTH=300
MAX_CONCURRENT_FEEDS=10
FEED_TIMEOUT=20
MAX_CONCURRENT_SUMMARIZATIONS=5
MAX_ARTICLE_AGE_HOURS=60
# LAST_RUN_FILE=config/.last_run
